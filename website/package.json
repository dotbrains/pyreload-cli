{
  "name": "@pyreload/website",
  "version": "1.0.0",
  "description": "Marketing website for Pyreload Python file monitor",
  "private": true,
  "scripts": {
    "dev": "npm run copy-assets && next dev -p 3004",
    "build": "npm run copy-assets && next build",
    "start": "next start -p 3004",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "copy-assets": "mkdir -p public && cp ../assets/og-image.svg public/og-image.svg"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.3.3"
  }
}
